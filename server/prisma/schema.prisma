generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  BUYER
  COMPANY
  INVESTOR
  BUILDER
  PATENT_PROFESSIONAL
  ADMIN
}

enum Visibility {
  PUBLIC
  PRIVATE
  RESTRICTED
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

model User {
  id               String                 @id @default(cuid())
  email            String                 @unique
  passwordHash     String?
  name             String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  verifiedAt       DateTime?
  suspended        Boolean                @default(false)
  roles            UserRole[]
  profile          Profile?
  innovations      Innovation[]
  messages         Message[]
  sentRequests     CollaborationRequest[] @relation("requester")
  receivedRequests CollaborationRequest[] @relation("recipient")
  favourites       Favourite[]
  notifications    Notification[]
  posts            CommunityPost[]
  auditLogs        AuditLog[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  headline  String?
  bio       String?
  skills    String[] @default([])
  interests String[] @default([])
  industry  String?
  location  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String  @id @default(cuid())
  userId      String  @unique
  name        String
  website     String?
  description String?
  industry    String?
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  innovations Innovation[]
}

model Innovation {
  id                 String            @id @default(cuid())
  creatorId          String
  title              String
  description        String
  categoryId         String
  visibility         Visibility        @default(PUBLIC)
  status             ListingStatus     @default(PENDING)
  price              Decimal?          @db.Decimal(10, 2)
  licensing          Boolean           @default(false)
  funding            Boolean           @default(false)
  ownershipConfirmed Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  creator            User              @relation(fields: [creatorId], references: [id])
  category           Category          @relation(fields: [categoryId], references: [id])
  media              InnovationMedia[]
  favourites         Favourite[]

  @@index([visibility, status, categoryId])
  @@index([creatorId])
}

model InnovationMedia {
  id           String     @id @default(cuid())
  innovationId String
  url          String
  mimeType     String
  access       Visibility @default(PUBLIC)
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  createdAt DateTime    @default(now())
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model MatchingResult {
  id          String   @id @default(cuid())
  userId      String
  targetId    String
  score       Float
  explanation String
  createdAt   DateTime @default(now())
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model CollaborationRequest {
  id          String   @id @default(cuid())
  requesterId String
  recipientId String
  status      String   @default("PENDING")
  message     String?
  createdAt   DateTime @default(now())
  requester   User     @relation("requester", fields: [requesterId], references: [id])
  recipient   User     @relation("recipient", fields: [recipientId], references: [id])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime        @default(now())
  members     ProjectMember[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Team {
  id          String           @id @default(cuid())
  name        String
  ownerId     String
  invitations TeamInvitation[]
}

model TeamInvitation {
  id     String @id @default(cuid())
  teamId String
  email  String
  status String @default("PENDING")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Favourite {
  id           String     @id @default(cuid())
  userId       String
  innovationId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)

  @@unique([userId, innovationId])
}

model Review {
  id           String   @id @default(cuid())
  authorId     String
  innovationId String
  rating       Int
  body         String
  createdAt    DateTime @default(now())
}

model Competition {
  id          String             @id @default(cuid())
  title       String
  description String
  deadline    DateTime?
  status      String             @default("DRAFT")
  entries     CompetitionEntry[]
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  userId        String
  innovationId  String?
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  votes         Vote[]

  @@index([competitionId])
}

model Vote {
  id        String           @id @default(cuid())
  entryId   String
  userId    String
  createdAt DateTime         @default(now())
  entry     CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
}

model Achievement {
  id          String @id @default(cuid())
  name        String
  description String
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())

  @@unique([userId, achievementId])
}

model CommunityPost {
  id        String    @id @default(cuid())
  authorId  String
  title     String
  body      String
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([authorId, createdAt])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Complaint {
  id         String   @id @default(cuid())
  reporterId String
  subject    String
  details    String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [adminId], references: [id])
}
